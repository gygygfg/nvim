    always_accept = {
      description = "允许全部",
      callback = "keymaps.always_accept",
      index = 1,
      modes = { n = "a" },
      opts = { nowait = true },
    },
    accept_change = {
      description = "允许一次",
      callback = "keymaps.accept_change",
      index = 2,
      modes = { n = "y" },
      opts = { nowait = true, noremap = true },
    },
    reject_change = {
      description = "拒绝更改",
      callback = "keymaps.reject_change",
