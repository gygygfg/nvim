# ================================
# 通用系统文件
# ================================
.DS_Store              # macOS 桌面服务存储文件
Thumbs.db              # Windows 缩略图缓存
desktop.ini           # Windows 文件夹自定义设置
*.swp                  # Vim 交换文件
*.swo                  # Vim 交换文件
*~                     # 备份文件
*.bak                  # 备份文件
*.tmp                  # 临时文件
*.temp                 # 临时文件

# ================================
# 开发环境/编辑器
# ================================
.vscode/               # VS Code 配置
.idea/                 # JetBrains IDE 配置
*.suo                  # Visual Studio 用户选项
*.user                 # Visual Studio 用户文件
*.userosscache         # Visual Studio 缓存
*.sln.docstates        # Visual Studio

# ================================
# 依赖/包管理
# ================================
node_modules/          # Node.js 依赖
vendor/               # Composer/PHP 依赖
packages/             # 各种包管理器的包目录
jspm_packages/        # JSPM 包
bower_components/     # Bower 组件
*.gem                 # Ruby gems
.env                  # 环境变量文件（通常包含敏感信息）
.env.local            # 本地环境变量
.env.*.local          # 环境变量本地文件
.env.development.local
.env.test.local
.env.production.local

# ================================
# 构建输出
# ================================
dist/                  # 分发/构建目录
build/                 # 构建目录
out/                   # 输出目录
target/               # Maven 目标目录
*.exe                  # 可执行文件
*.dll                  # 动态链接库
*.so                   # 共享对象（Linux）
*.dylib               # 动态库（macOS）
*.class               # Java 字节码
*.pyc                 # Python 字节码
__pycache__/          # Python 缓存目录
*.o                   # 对象文件
*.a                   # 静态库

# ================================
# 日志和数据库
# ================================
*.log                  # 日志文件
npm-debug.log*        # npm 调试日志
yarn-debug.log*       # yarn 调试日志
yarn-error.log*       # yarn 错误日志
*.sqlite               # SQLite 数据库
*.sqlite3              # SQLite3 数据库
*.db                   # 通用数据库文件

# ================================
# 测试和覆盖率
# ================================
coverage/              # 测试覆盖率报告
.nyc_output/           # NYC 覆盖率输出
*.lcov                # LCOV 覆盖率文件

# ================================
# 操作系统目录
# ================================
[Tt]humbs.db          # Windows 缩略图
ehthumbs.db           # Windows Explorer 缓存
Desktop.ini           # Windows 文件夹设置

# ================================
# 项目特定
# ================================
# 在此处添加您的项目特定忽略规则
nvim-pack-lock.json   # 自动生成的锁文件
